ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
NEWSAPI_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

YFINANCE_SOURCE_PATH=/Users/shubh./Downloads/yfinance-main
API_PORT=3001

# Ticker dashboard (SEC EDGAR) -- required identifying User-Agent per SEC's fair-access policy
EDGAR_USER_AGENT=NewsLabs Dashboard shubh.helloworld@gmail.com

# Firecrawl (notifications dashboard — Perplexity finance scrapes). Server-side only.
FIRECRAWL_API_KEY=

# Gemini (notifications — market classification). Server-side only.
GEMINI_API_KEY=
# Preferred Gemini model (tried first).
GEMINI_MODEL=gemini-3.6-flash
# Failover when preferred hits high demand / quota / 404 (comma-separated).
# Walked automatically on "experiencing high demand", 429, 503, unavailable, etc.
# If unset, server uses a built-in Flash-first list (3.6 → 3.5 → 3.4 → 3.2 → 2.5 → 2.0 → 1.5…).
GEMINI_MODEL_CASCADE=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.4-flash,gemini-3.2-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-omni-flash-preview,gemini-3.1-pro-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash-lite-preview,gemini-2.1-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-flash-8b,gemini-1.5-pro
# Max output tokens per generate call (ceiling 8192). Higher = room for full structure; you only pay for tokens actually generated.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Cost estimate: paid | free  (free → $0 estimated, tokens still logged as credits)
GEMINI_BILLING_TIER=paid
# Optional USD price overrides per 1M tokens (otherwise model defaults are used)
# GEMINI_PRICE_INPUT_PER_1M=0.30
# GEMINI_PRICE_OUTPUT_PER_1M=1.50

# Optional: required when Expo push security / enhanced security is enabled.
EXPO_ACCESS_TOKEN=

# Temporary push allowlist — when set, ALL Expo notifications only go to these
# device_id(s) and/or Expo token(s) (comma-separated). Empty = all eligible devices.
# Forced: still sends even if ticker has 0 watchlist subscribers (dev tester mode).
# Also enables dummy Perplexity on auto-start (no API spend) unless overridden.
# Remove before production multi-user fan-out.
# PUSH_ALLOWLIST_DEVICE_IDS=ios-…
# PUSH_ALLOWLIST_TOKENS=ExponentPushToken[…]
# MOMENTUM_DUMMY_RESEARCH=1  # force dummy · 0 = real Perplexity even with allowlist

# Market-close automation (server job + Supabase Edge/pg_cron).
# POST /api/notifications/jobs/market-close with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Set to 0 to disable the job without undeploying cron.
MARKET_CLOSE_JOB_ENABLED=1
# Edge Function secrets (set via `supabase secrets set`):
#   MARKET_CLOSE_API_URL=https://your-api-host/api/notifications/jobs/market-close
#   CRON_SECRET=<same as above>

# Perplexity Sonar (momentum “Run research” — built-in web search). Server-side only.
PERPLEXITY_API_KEY=
# e.g. perplexity/deepseek-v4-flash-0731 | sonar-pro | sonar
PERPLEXITY_MODEL=perplexity/deepseek-v4-flash-0731
